#!/usr/bin/env python3
"""FHIR Gateway: 资源校验、术语映射与审计留痕（一次完成）。

用法:
    fhir-gateway --audit-file PATH < request.json
    fhir-gateway --audit-chain --audit-file PATH < request.json
    fhir-gateway --verify-audit --audit-file PATH

仅使用 Python 标准库，从零实现，不依赖任何外部 FHIR/术语库。
支持单个 Patient/Observation/Condition，或 FHIR R4 Bundle（含若干 entry 资源）。
type 为 transaction/batch 的 Bundle 走批量执行语义：按 entry 顺序逐项校验与
术语映射（不写业务资源库），输出 transaction-response/batch-response Bundle。
成功: stdout 一行 JSON；审计记录追加到 --audit-file (JSON Lines)，每次提交一条。
失败: stdout 为空；stderr 一行 {"error": {...}}；退出码 2。

--audit-chain 开启审计完整性链：每条审计增加 audit_digest（SHA-256，64 位
小写十六进制），按 UTF-8 对上一条 audit_digest、换行和本条移除该字段后的
规范 JSON 计算，首条前序摘要为 64 个 0；规范 JSON 的对象键按 Unicode 码点
升序、分隔符后无空格、非 ASCII 原样保留。链式追加仅接受文件不存在、为空或
全行均可验证的链式审计。

--verify-audit 只校验链式文件（不读取标准输入）：从首行到末行检查结构、
audit_id 唯一性与摘要连续性；成功时 stdout 输出一行
{"status": "valid", "line_count": N, "last_audit_id": ..., "last_audit_digest": ...}。
"""

import hashlib
import json
import os
import re
import sys
import uuid

ALLOWED_RESOURCE_TYPES = ("Patient", "Observation", "Condition")

# FHIR R4 Bundle.type
# http://hl7.org/fhir/R4/valueset-bundle-type.html
BUNDLE_TYPES = (
    "document",
    "message",
    "transaction",
    "transaction-response",
    "batch",
    "batch-response",
    "history",
    "searchset",
    "collection",
)

# 走批量执行语义的 Bundle.type：transaction 全有或全无，batch 逐项独立。
EXECUTABLE_BUNDLE_TYPES = ("transaction", "batch")

# transaction/batch entry 支持的 HTTP 方法。
SUPPORTED_METHODS = ("POST", "PUT")

# FHIR R4 Observation.status
# http://hl7.org/fhir/R4/valueset-observation-status.html
OBSERVATION_STATUSES = (
    "registered",
    "preliminary",
    "final",
    "amended",
    "cancelled",
    "corrected",
    "entered-in-error",
    "unknown",
)

# 完整性链常量：摘要字段名、算法、首条前序摘要（64 个 0）。
DIGEST_FIELD = "audit_digest"
GENESIS_DIGEST = "0" * 64
DIGEST_RE = re.compile(r"^[0-9a-f]{64}$")


class GatewayError(Exception):
    """所有受控错误的基类，type 取具体异常类名。"""


class InputError(GatewayError):
    """JSON、请求结构或 audit_context 非法。"""


class FhirValidationError(GatewayError):
    """FHIR 资源非法。"""


class TermMappingError(GatewayError):
    """术语映射项非法，或同一源编码存在多个目标。"""


class AuditWriteError(GatewayError):
    """审计文件缺失参数、路径非法、无权限、追加不完整或链式校验失败。"""


class AuditVerificationError(GatewayError):
    """链式审计结构、audit_id 唯一性或摘要连续性校验失败。"""


class AuditReadError(GatewayError):
    """链式审计文件缺失、路径为目录、父目录不存在或读取失败。"""



def _is_nonempty_str(value):
    return isinstance(value, str) and value != ""


def _find_codings(node, out):
    """收集资源内所有含非空 system/code 的编码对象（Coding 形态）。"""
    if isinstance(node, dict):
        system = node.get("system")
        code = node.get("code")
        if _is_nonempty_str(system) and _is_nonempty_str(code):
            out.append({"system": system, "code": code})
        for value in node.values():
            _find_codings(value, out)
    elif isinstance(node, list):
        for item in node:
            _find_codings(item, out)


def _primary_coding(codeable_concept, label):
    """校验 CodeableConcept，返回其首个含非空 system/code 的 coding。"""
    if not isinstance(codeable_concept, dict):
        raise FhirValidationError("%s 必须为 CodeableConcept 对象" % label)
    codings = codeable_concept.get("coding")
    if not isinstance(codings, list) or codings == []:
        raise FhirValidationError("%s.coding 必须为非空数组" % label)
    coding = codings[0]
    if not isinstance(coding, dict):
        raise FhirValidationError("%s.coding[0] 必须为对象" % label)
    if not _is_nonempty_str(coding.get("system")):
        raise FhirValidationError("%s 含非空 system" % label)
    if not _is_nonempty_str(coding.get("code")):
        raise FhirValidationError("%s 含非空 code" % label)
    return coding


def validate_resource(resource):
    """按任务约定校验 Patient / Observation / Condition。"""
    if not isinstance(resource, dict):
        raise FhirValidationError("resource 必须为对象")

    resource_type = resource.get("resourceType")
    if resource_type not in ALLOWED_RESOURCE_TYPES:
        raise FhirValidationError(
            "resource.resourceType 仅限 %s" % "、".join(ALLOWED_RESOURCE_TYPES)
        )

    if not _is_nonempty_str(resource.get("id")):
        raise FhirValidationError("resource.id 必须为非空字符串")

    if resource_type == "Observation":
        if resource.get("status") not in OBSERVATION_STATUSES:
            raise FhirValidationError(
                "Observation.status 不符合 FHIR R4 ObservationStatus"
            )
        _primary_coding(resource.get("code"), "Observation.code")

    if resource_type == "Condition":
        _primary_coding(resource.get("clinicalStatus"), "Condition.clinicalStatus")


def validate_bundle(bundle):
    """校验 FHIR R4 Bundle：非空 id、合法 type，entry 内资源逐项校验。"""
    if not isinstance(bundle, dict):
        raise FhirValidationError("resource 必须为对象")

    if bundle.get("resourceType") != "Bundle":
        raise FhirValidationError("resource.resourceType 必须为 Bundle")

    if not _is_nonempty_str(bundle.get("id")):
        raise FhirValidationError("Bundle.id 必须为非空字符串")

    if bundle.get("type") not in BUNDLE_TYPES:
        raise FhirValidationError(
            "Bundle.type 仅限 %s" % "、".join(BUNDLE_TYPES)
        )

    if "entry" in bundle:
        entries = bundle["entry"]
        if not isinstance(entries, list):
            raise FhirValidationError("Bundle.entry 必须为数组")
        for pos, entry in enumerate(entries):
            label = "Bundle.entry[%d]" % pos
            if not isinstance(entry, dict):
                raise FhirValidationError("%s 必须为对象" % label)
            if "resource" not in entry:
                raise FhirValidationError("%s 缺少 resource" % label)
            # entry 内复用同一套 Patient/Observation/Condition 校验。
            validate_resource(entry["resource"])


def validate_audit_context(audit_context):
    if not isinstance(audit_context, dict):
        raise InputError("audit_context 必须为对象")
    for field in ("request_id", "actor", "recorded_at"):
        if not _is_nonempty_str(audit_context.get(field)):
            raise InputError("audit_context.%s 必须为非空字符串" % field)


def build_term_index(term_maps):
    """term_maps -> {(system, code): (target_system, target_code)}。"""
    if not isinstance(term_maps, list):
        raise InputError("term_maps 必须为数组")

    index = {}
    for pos, item in enumerate(term_maps):
        label = "term_maps[%d]" % pos
        if not isinstance(item, dict):
            raise TermMappingError("%s 必须为对象" % label)
        for field in ("system", "code", "target_system", "target_code"):
            if not _is_nonempty_str(item.get(field)):
                raise TermMappingError("%s.%s 必须为非空字符串" % (label, field))

        key = (item["system"], item["code"])
        target = (item["target_system"], item["target_code"])
        if key in index and index[key] != target:
            raise TermMappingError(
                "同一源编码 %s 存在多个映射目标" % json.dumps(
                    {"system": key[0], "code": key[1]}, ensure_ascii=False
                )
            )
        index[key] = target
    return index


def apply_mappings(resource, index):
    """为资源内每个 system/code 对象生成映射结果；资源本身不改写。"""
    codings = []
    _find_codings(resource, codings)

    mappings = []
    for coding in codings:
        target = index.get((coding["system"], coding["code"]))
        mappings.append(
            {
                "source": {"system": coding["system"], "code": coding["code"]},
                "status": "mapped" if target is not None else "unmapped",
                "target": (
                    None
                    if target is None
                    else {"system": target[0], "code": target[1]}
                ),
            }
        )
    return mappings


def apply_bundle_mappings(bundle, index):
    """按 entry 顺序、资源内嵌套顺序收集编码；entry 缺失/空则无映射。"""
    mappings = []
    entries = bundle.get("entry") or []
    for entry in entries:
        mappings.extend(apply_mappings(entry["resource"], index))
    return mappings


def _entry_resource_type(entry):
    """尽力取 entry.resource.resourceType，用于响应与审计；取不到为 None。"""
    if isinstance(entry, dict):
        resource = entry.get("resource")
        if isinstance(resource, dict) and isinstance(resource.get("resourceType"), str):
            return resource["resourceType"]
    return None


def check_bundle_entry(pos, entry, term_index, term_index_error):
    """按顺序执行单条 entry 的结构、校验与映射检查。

    返回 (phase, code, expression, message)；全部通过返回 None。
    code 取值：invalid（缺 request/resource、URL 类型不一致）、
    not-supported（method 不支持）、processing（校验或映射失败）。
    """
    label = "Bundle.entry[%d]" % pos
    if not isinstance(entry, dict):
        return ("request", "invalid", label, "%s 必须为对象" % label)
    if "request" not in entry:
        return ("request", "invalid", label + ".request", "%s 缺少 request" % label)
    if "resource" not in entry:
        return ("request", "invalid", label + ".resource", "%s 缺少 resource" % label)

    request = entry["request"]
    if not isinstance(request, dict):
        return (
            "request",
            "invalid",
            label + ".request",
            "%s.request 必须为对象" % label,
        )

    resource = entry["resource"]
    url = request.get("url")
    first_segment = url.split("/")[0] if isinstance(url, str) else ""
    resource_type = resource.get("resourceType") if isinstance(resource, dict) else None
    if not _is_nonempty_str(url) or first_segment != resource_type:
        return (
            "request",
            "invalid",
            label + ".request.url",
            "%s.request.url 首段必须等于 resource.resourceType" % label,
        )

    if request.get("method") not in SUPPORTED_METHODS:
        return (
            "request",
            "not-supported",
            label + ".request.method",
            "%s.request.method 仅支持 %s" % (label, "、".join(SUPPORTED_METHODS)),
        )

    try:
        validate_resource(resource)
    except FhirValidationError as exc:
        return ("validation", "processing", label + ".resource", str(exc))

    if term_index_error is not None:
        return ("mapping", "processing", label + ".resource", str(term_index_error))
    apply_mappings(resource, term_index)
    return None


def execute_bundle_entry(pos, entry, term_index, term_index_error):
    """执行单条 entry，返回响应 entry 与审计 entry（不写业务资源库）。"""
    failure = check_bundle_entry(pos, entry, term_index, term_index_error)
    status = 400 if failure is not None else 200

    response_entry = {"resourceType": _entry_resource_type(entry), "status": status}
    issue_code = None
    phase = "completed"
    if failure is not None:
        phase, issue_code, expression, message = failure
        response_entry["outcome"] = {
            "resourceType": "OperationOutcome",
            "issue": [
                {
                    "severity": "error",
                    "code": issue_code,
                    "entry": pos,
                    "expression": expression,
                    "diagnostics": message,
                }
            ],
        }

    audit_entry = {
        "index": pos,
        "resource_type": response_entry["resourceType"],
        "phase": phase,
        "status": status,
        "issue_code": issue_code,
    }
    return {
        "status": status,
        "response_entry": response_entry,
        "audit_entry": audit_entry,
    }


def process_executable_bundle(bundle, term_maps, audit_context, audit_path, chain=False):
    """transaction/batch：按 entry 顺序逐项校验与映射，汇总为响应 Bundle。"""
    if not _is_nonempty_str(bundle.get("id")):
        raise FhirValidationError("Bundle.id 必须为非空字符串")
    entries = bundle.get("entry", [])
    if not isinstance(entries, list):
        raise FhirValidationError("Bundle.entry 必须为数组")

    # term_maps 非数组仍是 InputError；映射项非法/同源冲突降级为逐项 mapping 失败。
    try:
        term_index = build_term_index(term_maps)
        term_index_error = None
    except TermMappingError as exc:
        term_index = None
        term_index_error = exc

    results = [
        execute_bundle_entry(pos, entry, term_index, term_index_error)
        for pos, entry in enumerate(entries)
    ]
    failed = sum(1 for r in results if r["status"] != 200)

    # transaction 全有或全无；batch 逐项独立，整体始终 200。
    if bundle["type"] == "transaction":
        overall_status = 400 if failed else 200
    else:
        overall_status = 200

    response_bundle = {
        "resourceType": "Bundle",
        "id": bundle["id"],
        "type": bundle["type"] + "-response",
        "entry": [r["response_entry"] for r in results],
    }

    audit = {
        "request_id": audit_context["request_id"],
        "actor": audit_context["actor"],
        "recorded_at": audit_context["recorded_at"],
        "decision": "accepted",
        "audit_id": uuid.uuid4().hex,
        "bundle_type": bundle["type"],
        "entry_total": len(results),
        "entry_succeeded": len(results) - failed,
        "entry_failed": failed,
        "status": overall_status,
        "entries": [r["audit_entry"] for r in results],
    }

    # 先落审计，再输出 stdout，保证审计失败时 stdout 一定为空。
    audit = append_audit_line(audit_path, audit, chain)

    result = {
        "status": overall_status,
        "resource_type": "Bundle",
        "resource": response_bundle,
        "audit": audit,
    }
    return json.dumps(result, ensure_ascii=False)


def canonical_json(obj):
    """规范 JSON：对象键按 Unicode 码点升序，分隔符后无空格，非 ASCII 原样。"""
    return json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def compute_digest(prev_digest, audit_without_digest):
    """对上一条摘要、换行与本条规范 JSON（UTF-8）计算 SHA-256。"""
    material = prev_digest + "\n" + canonical_json(audit_without_digest)
    return hashlib.sha256(material.encode("utf-8")).hexdigest()


def _is_hex64(value):
    return isinstance(value, str) and DIGEST_RE.match(value) is not None


def _chain_line_error(pos, message):
    return "第 %d 行: %s" % (pos + 1, message)


def validate_chain_lines(raw_text):
    """逐行校验链式审计，返回 (条数, 末条 audit_id, 末条 audit_digest)。

    空文件（无任何非空行）返回 (0, None, None)。
    结构、audit_id 唯一性、摘要连续性任一不满足抛 AuditVerificationError。
    """
    seen_ids = set()
    prev_digest = GENESIS_DIGEST
    count = 0
    last_audit_id = None
    last_digest = None

    for pos, raw_line in enumerate(raw_text.splitlines()):
        if raw_line.strip() == "":
            raise AuditVerificationError(_chain_line_error(pos, "存在空行"))
        try:
            record = json.loads(raw_line)
        except (json.JSONDecodeError, ValueError) as exc:
            raise AuditVerificationError(
                _chain_line_error(pos, "JSON 解析失败: %s" % exc)
            )
        if not isinstance(record, dict):
            raise AuditVerificationError(_chain_line_error(pos, "行非 JSON 对象"))

        digest = record.get(DIGEST_FIELD)
        if not _is_hex64(digest):
            raise AuditVerificationError(
                _chain_line_error(pos, "audit_digest 缺失或格式错误")
            )
        audit_id = record.get("audit_id")
        if not _is_nonempty_str(audit_id):
            raise AuditVerificationError(
                _chain_line_error(pos, "audit_id 缺失或为空")
            )
        if audit_id in seen_ids:
            raise AuditVerificationError(
                _chain_line_error(pos, "audit_id 重复: %s" % audit_id)
            )

        body = dict(record)
        del body[DIGEST_FIELD]
        expected = compute_digest(prev_digest, body)
        if digest != expected:
            raise AuditVerificationError(
                _chain_line_error(pos, "摘要不匹配，审计链断裂")
            )

        seen_ids.add(audit_id)
        prev_digest = digest
        count += 1
        last_audit_id = audit_id
        last_digest = digest

    return count, last_audit_id, last_digest


def read_chain_file(path):
    """读取链式审计文件文本；文件/目录/父目录/读取问题统一为 AuditReadError。"""
    parent = os.path.dirname(os.path.abspath(path))
    if not os.path.isdir(parent):
        raise AuditReadError("审计文件父目录不存在: %s" % parent)
    if os.path.isdir(path):
        raise AuditReadError("审计路径是目录: %s" % path)
    if not os.path.exists(path):
        raise AuditReadError("审计文件不存在: %s" % path)
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError as exc:
        raise AuditReadError("读取审计文件失败 %s: %s" % (path, exc.strerror or exc))
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise AuditReadError("审计文件不是合法 UTF-8: %s" % exc)


def append_audit_line(path, audit, chain=False):
    """将审计 JSON 追加为 JSON Lines 的一行，保留已有行。

    chain=True 时写入前先全量校验既有链式审计，并为新条目计算 audit_digest；
    校验失败抛 AuditWriteError，且不追加本条。普通模式可读取任意已有 JSON Lines。
    """
    if chain:
        # 校验通过后才计算摘要：既有行非链式/断链/重复 ID/缺字段/不可读时，
        # 本条绝不追加；写入路径统一以 AuditWriteError 上报（verify 模式才
        # 区分 AuditVerificationError / AuditReadError）。
        try:
            if os.path.exists(path):
                _, _, last_digest = validate_chain_lines(read_chain_file(path))
                prev_digest = (
                    last_digest if last_digest is not None else GENESIS_DIGEST
                )
            else:
                parent = os.path.dirname(os.path.abspath(path))
                if not os.path.isdir(parent):
                    raise AuditWriteError("审计文件父目录不存在: %s" % parent)
                prev_digest = GENESIS_DIGEST
        except AuditWriteError:
            raise
        except (AuditReadError, AuditVerificationError) as exc:
            raise AuditWriteError(str(exc))
        audit = dict(audit)
        audit[DIGEST_FIELD] = compute_digest(prev_digest, audit)

    line = json.dumps(audit, ensure_ascii=False) + "\n"
    payload = line.encode("utf-8")

    # 已有文件若缺少结尾换行，先补一个分隔符，避免与上一行粘连（不改动旧行内容）。
    prefix = b""
    try:
        with open(path, "rb") as existing:
            existing.seek(-1, os.SEEK_END)
            if existing.read(1) != b"\n":
                prefix = b"\n"
    except FileNotFoundError:
        prefix = b""
    except OSError:
        prefix = b""

    data = prefix + payload
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    except OSError as exc:
        raise AuditWriteError("无法打开审计文件 %s: %s" % (path, exc.strerror or exc))

    written = 0
    try:
        while written < len(data):
            n = os.write(fd, data[written:])
            if n <= 0:
                raise AuditWriteError("审计文件追加不完整: %s" % path)
            written += n
        os.fsync(fd)
    except OSError as exc:
        raise AuditWriteError("审计文件追加失败 %s: %s" % (path, exc.strerror or exc))
    finally:
        try:
            os.close(fd)
        except OSError:
            pass

    if written != len(data):
        raise AuditWriteError("审计文件追加不完整: %s" % path)

    return audit


def parse_args(argv):
    audit_path = None
    chain = False
    verify = False
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            sys.stdout.write(__doc__)
            sys.exit(0)
        elif arg == "--audit-file":
            if i + 1 >= len(argv):
                raise AuditWriteError("--audit-file 缺少文件路径参数")
            audit_path = argv[i + 1]
            i += 2
        elif arg.startswith("--audit-file="):
            audit_path = arg[len("--audit-file=") :]
            if audit_path == "":
                raise AuditWriteError("--audit-file 缺少文件路径参数")
            i += 1
        elif arg == "--audit-chain":
            chain = True
            i += 1
        elif arg == "--verify-audit":
            verify = True
            i += 1
        else:
            raise AuditWriteError("未知参数: %s" % arg)

    if audit_path is None:
        if verify:
            raise AuditReadError("--verify-audit 需要配合 --audit-file PATH")
        raise AuditWriteError("缺少必需参数 --audit-file")
    return audit_path, chain, verify


def process(raw_text, audit_path, chain=False):
    try:
        request = json.loads(raw_text)
    except (json.JSONDecodeError, ValueError) as exc:
        raise InputError("请求不是合法 JSON: %s" % exc)

    if not isinstance(request, dict):
        raise InputError("请求必须为 JSON 对象")

    for field in ("resource", "term_maps", "audit_context"):
        if field not in request:
            raise InputError("请求缺少字段: %s" % field)

    resource = request["resource"]
    term_maps = request["term_maps"]
    audit_context = request["audit_context"]

    validate_audit_context(audit_context)

    is_bundle = isinstance(resource, dict) and resource.get("resourceType") == "Bundle"
    if is_bundle and resource.get("type") in EXECUTABLE_BUNDLE_TYPES:
        # transaction/batch：批量执行语义，entry 问题进入响应而非网关级错误。
        return process_executable_bundle(
            resource, term_maps, audit_context, audit_path, chain
        )
    if is_bundle:
        # 顺序：Bundle 自身 → 各 entry.resource（均在 term_maps 校验之前）。
        validate_bundle(resource)
    else:
        validate_resource(resource)
    index = build_term_index(term_maps)
    mappings = (
        apply_bundle_mappings(resource, index)
        if is_bundle
        else apply_mappings(resource, index)
    )

    audit = {
        "request_id": audit_context["request_id"],
        "actor": audit_context["actor"],
        "recorded_at": audit_context["recorded_at"],
        "decision": "accepted",
        "audit_id": uuid.uuid4().hex,
    }

    # 先落审计，再输出 stdout，保证审计失败时 stdout 一定为空。
    audit = append_audit_line(audit_path, audit, chain)

    result = {
        "status": "accepted",
        "resource_type": resource["resourceType"],
        "resource": resource,
        "mappings": mappings,
        "audit": audit,
    }
    return json.dumps(result, ensure_ascii=False)


def verify_audit_file(path):
    """只校验链式文件：结构、audit_id 唯一性与摘要连续性；不读取标准输入。"""
    raw_text = read_chain_file(path)
    line_count, last_audit_id, last_digest = validate_chain_lines(raw_text)
    return {
        "status": "valid",
        "line_count": line_count,
        "last_audit_id": last_audit_id,
        "last_audit_digest": last_digest,
    }


def main(argv):
    try:
        audit_path, chain, verify = parse_args(argv)
    except GatewayError as exc:
        _emit_error(exc)
        return 2

    if verify:
        # 校验模式不读取标准输入。
        try:
            report = verify_audit_file(audit_path)
        except GatewayError as exc:
            _emit_error(exc)
            return 2
        sys.stdout.write(
            json.dumps(report, ensure_ascii=False, separators=(",", ":")) + "\n"
        )
        sys.stdout.flush()
        return 0

    try:
        raw_text = sys.stdin.read()
    except OSError as exc:
        _emit_error(InputError("读取标准输入失败: %s" % exc))
        return 2

    try:
        output = process(raw_text, audit_path, chain)
    except GatewayError as exc:
        _emit_error(exc)
        return 2

    sys.stdout.write(output + "\n")
    sys.stdout.flush()
    return 0


def _emit_error(exc):
    payload = {"error": {"type": type(exc).__name__, "message": str(exc) or "error"}}
    sys.stderr.write(json.dumps(payload, ensure_ascii=False) + "\n")
    sys.stderr.flush()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
